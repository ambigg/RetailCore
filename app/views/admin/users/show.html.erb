<div class="page-header">
  <div>
    <h1 class="page-title"><%= @user.name %></h1>
    <div class="page-subtitle"><%= @user.email %> · <%= @user.role %></div>
  </div>
  <%= link_to "Back", :back, class: "btn btn-outline" %>
</div>
<div class="row mb-4">
  <div class="col-md-6">
    <div class="card">
      <div class="profile-header">
        <div class="avatar"><%= @user.name&.first&.upcase || @user.email.first.upcase %></div>
        <div>
          <div class="page-title"><%= @user.name %></div>
          <div class="page-subtitle"><%= @user.email %></div>
          <span class="role-badge"><%= @user.role %></span>
        </div>
      </div>
      <div class="profile-body">
        <div class="field">
          <div class="form-label">Phone</div>
          <div class="text-muted"><%= @user.phone.presence || "—" %></div>
        </div>
        <div class="field">
          <div class="form-label">Address</div>
          <div class="text-muted"><%= @user.address.presence || "—" %></div>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="page-subtitle mb-2">Orders</div>
<div class="card">
  <table class="table">
    <thead>
      <tr>
        <th>Order ID</th>
        <th>Date</th>
        <th>Status</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td class="text-muted">#<%= order.id %></td>
          <td><%= order.created_at.strftime("%B %d, %Y") %></td>
          <td><%= order.status.humanize %></td>
          <td class="text-accent"><%= number_to_currency(order.total) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
